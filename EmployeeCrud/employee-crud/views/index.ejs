<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/header') %>
  <title>Employees</title>
</head>
<body>
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2><i class="fa-solid fa-users"></i> Employee Directory</h2>
      <a href="/new" class="btn btn-success">
        <i class="fa fa-plus"></i> Add Employee
      </a>
    </div>

    <table class="table table-hover table-striped">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Address</th>
          <th>Salary</th>
          <th>Gender</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (employees.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center text-muted">No employees found.</td>
          </tr>
        <% } else { %>
          <% employees.forEach(emp => { %>
            <tr>
              <td><%= emp.name %></td>
              <td><%= emp.address %></td>
              <td>$<%= emp.salary %></td>
              <td><%= emp.gender %></td>
              <td class="text-center">
                <a href="/edit/<%= emp._id %>" class="btn btn-warning btn-sm">
                  <i class="fa fa-pen"></i> Edit
                </a>
                <form action="/delete/<%= emp._id %>?_method=DELETE" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-danger btn-sm">
                    <i class="fa fa-trash"></i> Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
